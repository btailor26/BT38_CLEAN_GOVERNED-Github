# BT38 exact GitHub-head candidate alignment layer.
#
# Keep the proven production dependency/runtime stack as the base, but overlay
# the COMPLETE deployable GitHub source tree from the exact audited commit.
# This removes the unsafe assumption that a historic Git commit exactly matches
# the pinned Fly base image. .dockerignore excludes tests, docs, local state,
# virtualenvs and other non-runtime material from the image build context.
FROM registry.fly.io/bt38-prod:deployment-01M2BK6REHCGKJQ34796T3WK8P@sha256:3f7ca913f010fea40a0b8fe20354cae7c010f802328fa0e1eb41258f32168a8b

WORKDIR /app

# Complete current branch runtime/source overlay. This is the authoritative
# alignment step: all current Python modules, models, routes, services,
# templates, static assets, migrations and runtime configuration are carried.
COPY . /app

# Keep explicit critical copies as fail-fast build contracts and documentary
# proof for the highest-risk release deltas. These are intentionally redundant
# with COPY . /app and must resolve from the same exact GitHub checkout.
COPY services/support_notification_alignment.py /app/services/support_notification_alignment.py
COPY services/package_catalog_alignment.py /app/services/package_catalog_alignment.py
COPY templates/admin/packages.html /app/templates/admin/packages.html
COPY migrations/manual/20260912-package-pricing-discount.sql /app/migrations/manual/20260912-package-pricing-discount.sql
COPY scripts/verify_production_db_contract.py /app/scripts/verify_production_db_contract.py
COPY fly.toml /app/fly.toml
COPY Dockerfile.current-image-alignment /app/Dockerfile.current-image-alignment
