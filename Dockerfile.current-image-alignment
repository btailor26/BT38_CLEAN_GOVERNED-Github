# BT38 exact GitHub-head candidate alignment layer.
#
# Reuse only the proven production dependency/runtime stack from the pinned
# image. Application source is replaced completely by the exact audited GitHub
# checkout so a historic base-image/source mismatch cannot leak stale features
# into the candidate. .dockerignore excludes tests, docs, local state and venvs.
FROM registry.fly.io/bt38-prod:deployment-01M2BK6REHCGKJQ34796T3WK8P@sha256:3f7ca913f010fea40a0b8fe20354cae7c010f802328fa0e1eb41258f32168a8b

WORKDIR /app

# Preserve the base image's locked virtual environment only. Remove all old
# /app source/config/assets first so deleted or renamed historical files cannot
# survive underneath the current branch and become accidental runtime authority.
RUN find /app -mindepth 1 -maxdepth 1 ! -name '.venv' -exec rm -rf {} +

# Complete exact-head source overlay: current Python modules, models, routes,
# services, templates, static assets, migrations and runtime configuration.
COPY . /app

# Explicit critical copies remain fail-fast build contracts for the highest-risk
# release deltas. They are redundant with COPY . /app by design and resolve from
# the same exact GitHub checkout.
COPY services/support_notification_alignment.py /app/services/support_notification_alignment.py
COPY services/package_catalog_alignment.py /app/services/package_catalog_alignment.py
COPY templates/admin/packages.html /app/templates/admin/packages.html
COPY migrations/manual/20260912-package-pricing-discount.sql /app/migrations/manual/20260912-package-pricing-discount.sql
COPY scripts/verify_production_db_contract.py /app/scripts/verify_production_db_contract.py
COPY fly.toml /app/fly.toml
COPY Dockerfile.current-image-alignment /app/Dockerfile.current-image-alignment
